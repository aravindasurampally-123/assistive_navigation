# OpenRouteService API Key (Get a free key from https://openrouteservice.org)
# Note: If no key is provided, the system automatically falls back to public OSRM walking routes.
ORS_API_KEY=your_openrouteservice_api_key_here

# Emergency SOS Email or Webhook (Optional simulation endpoint)
EMERGENCY_ALERT_WEBHOOK=

# Default Geolocation (Latitude, Longitude) when GPS is unavailable
DEFAULT_LAT=17.3850
DEFAULT_LON=78.4867
